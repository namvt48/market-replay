# Economic calendar sample shard — SYNTHETIC placeholder rows, not real data.
#
# Install by copying into the data directory the server reads:
#     mkdir -p data/econ && cp pipeline/econ.sample.jsonl data/econ/2026.jsonl
# Shard however you like (2024.jsonl, 2025.jsonl, …); every *.jsonl in
# data/econ is merged, and SIGHUP reloads them alongside the bar files.
#
# Full field reference:  go doc market-replay/internal/econ
#
# Required: id (unique across all shards), ts (epoch seconds UTC, the release
# time), country, title, importance (low|medium|high).
# Optional: currency, forecast, previous, actual, announcedTs, source.
#
# Values stay strings on purpose — real releases read "0.3%", "215K",
# "3.75%-4.00%" — and `actual` is withheld from clients until the replay
# cursor reaches ts, so a trader cannot read a number before it printed.
#
# Blank lines and #-comments are ignored. Unknown field names are rejected
# rather than skipped, so a typo fails the load instead of silently
# downgrading an event.
{"id":"sample-us-ism-2026-08-03","ts":1785765600,"country":"US","currency":"USD","title":"ISM Manufacturing PMI","importance":"medium","forecast":"51.2","previous":"50.8","actual":"51.0","source":"sample"}
