{"id":"sample-us-nfp-2026-08-07","ts":1786105800,"country":"US","currency":"USD","title":"Nonfarm Payrolls","importance":"high","forecast":"165K","previous":"147K","actual":"185K","source":"sample"}
{"id":"sample-us-unemployment-2026-08-07","ts":1786105800,"country":"US","currency":"USD","title":"Unemployment Rate","importance":"high","forecast":"4.2%","previous":"4.1%","actual":"4.3%","source":"sample"}
{"id":"sample-us-cpi-2026-08-12","ts":1786537800,"country":"US","currency":"USD","title":"CPI m/m","importance":"high","forecast":"0.2%","previous":"0.3%","actual":"0.4%","source":"sample"}
